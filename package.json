{
  "name": "space-shooter",
  "version": "1.0.0",
  "description": "HTML5 Canvas Asteroids-style space shooter game",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "cp -r src/assets dist/ 2>/dev/null || true",
    "dev": "tsc --watch",
    "serve": "npx serve dist -p 3534",
    "lint": "eslint src/**/*.ts",
    "test": "echo \"No tests configured yet\""
  },
  "keywords": ["game", "canvas", "typescript", "space-shooter"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0"
  }
}
